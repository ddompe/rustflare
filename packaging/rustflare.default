# Rustflare settings (systemd EnvironmentFile). Restart after editing:  sudo systemctl restart rustflare

# Address and port to listen on (plain HTTP). Without a password below there is NO authentication: trusted networks only.
RUSTFLARE_BIND=0.0.0.0:8080

# Default capture directory (on the SD card). You normally choose a USB drive in the web UI
# (Storage panel); that choice is saved in /var/lib/rustflare/rustflare.json and takes precedence over this.
RUSTFLARE_DATA_DIR=/var/lib/rustflare/captures


# Password for the web UI and API (HTTP Basic, any user name). Strongly recommended together with HTTPS
# (`sudo rustflare-tls`, see docs/guide/phone-setup.md); over plain HTTP the password travels in the clear.
#RUSTFLARE_PASSWORD=
# HTTPS: after `sudo rustflare-tls` the server also listens here. Plain HTTP then only serves the CA and redirects.
#RUSTFLARE_TLS_BIND=0.0.0.0:8443
