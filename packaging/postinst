#!/bin/sh
set -e
case "$1" in
configure)
    if ! getent passwd rustflare >/dev/null; then
        adduser --system --group --home /var/lib/rustflare --no-create-home --gecos "Rustflare" rustflare
    fi
    for g in dialout plugdev; do
        getent group "$g" >/dev/null && adduser --quiet rustflare "$g" || true
    done
    install -d -o rustflare -g rustflare -m 0755 /var/lib/rustflare /var/lib/rustflare/captures
    # First install via `sudo apt install`: run as the person installing, so USB drives that the desktop
    # auto-mounts for that login are writable. Not applied again on upgrades or unattended updates.
    if [ ! -e /etc/systemd/system/rustflare.service.d/user.conf ] && [ -n "${SUDO_USER:-}" ] \
       && [ "$SUDO_USER" != root ] && [ "$(id -u "$SUDO_USER" 2>/dev/null || echo 0)" -ge 1000 ]; then
        /usr/bin/rustflare-user --no-restart "$SUDO_USER" || true
    fi
    # the stacker runs as the same account as the recorder (it reads and writes the same folders)
    if [ -r /etc/systemd/system/rustflare.service.d/user.conf ]; then
        install -d /etc/systemd/system/rustflare-stack.service.d
        cp /etc/systemd/system/rustflare.service.d/user.conf /etc/systemd/system/rustflare-stack.service.d/user.conf
    fi
    # lets the recorder start the stacker service again if it stopped (and only that, only "start"): the rule names the account the
    # recorder really runs as, which `rustflare-user` may have changed
    RUN_USER=$(systemctl show -p User --value rustflare.service 2>/dev/null)
    [ -n "$RUN_USER" ] || RUN_USER=rustflare
    if [ -d /etc/polkit-1/rules.d ]; then
        cat > /etc/polkit-1/rules.d/50-rustflare-stack.rules <<RULE
// Lets the recorder (account "$RUN_USER") start the stacker service again if it stopped, and nothing else.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "rustflare-stack.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "$RUN_USER") {
        return polkit.Result.YES;
    }
});
RULE
        chmod 644 /etc/polkit-1/rules.d/50-rustflare-stack.rules
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=usb 2>/dev/null || true
    fi
    systemctl daemon-reload || true
    systemctl enable rustflare.service >/dev/null 2>&1 || true
    # the stacker is always ready: it waits at the lowest priority and only touches recordings the recorder has marked finished
    systemctl enable rustflare-stack.service >/dev/null 2>&1 || true
    # restart (not start) so an upgrade runs the new binary
    systemctl restart rustflare.service || true
    systemctl restart rustflare-stack.service || true
    ;;
esac
exit 0
